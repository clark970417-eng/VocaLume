{
  "name": "live-translate",
  "version": "4.6.6",
  "description": "Local-first multilingual live captions and browser translation",
  "main": "./out/main/index.js",
  "scripts": {
    "build:voice-tone": "node scripts/build-voice-tone.cjs",
    "postinstall": "node scripts/fix-whisper-addon.js",
    "prebuild": "node scripts/fix-whisper-addon.js",
    "dev": "electron-vite dev",
    "build": "node scripts/build-app.cjs",
    "preview": "electron-vite preview",
    "package": "npm run build && electron-builder",
    "package:dmg": "npm run build && electron-builder --mac dmg",
    "package:win": "npm run build && electron-builder --win nsis",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --tsBuildInfoFile node_modules/.cache/typecheck-node.tsbuildinfo && tsc --noEmit -p tsconfig.web.json --tsBuildInfoFile node_modules/.cache/typecheck-web.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "bench:stt": "cd benchmark && npm run stt",
    "bench:stt:all": "cd benchmark && npm run stt:all",
    "bench:stt:generate": "cd benchmark && npm run stt:generate-testset",
    "shadow:ja-en": "LT_SHADOW_JA_EN=1 electron-vite dev",
    "shadow:ja-en:cloud": "LT_SHADOW_JA_EN=1 LT_SHADOW_CLOUD=1 electron-vite dev",
    "shadow:ja-en:cloud-all": "LT_SHADOW_JA_EN=1 LT_SHADOW_CLOUD=1 LT_SHADOW_GEMINI_LIVE=1 electron-vite dev",
    "test:stability": "node scripts/stability-gate.mjs",
    "diagnose:compatibility": "node scripts/qualification-report.mjs"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@huggingface/transformers": "^3.8.0",
    "@kutalia/whisper-node-addon": "^1.1.0",
    "@ricky0123/vad-web": "^0.0.30",
    "deepfilternet3-noise-filter": "^1.2.1",
    "electron-audio-loopback": "^1.0.6",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.3.0",
    "ffmpeg-static": "^5.2.0",
    "kokoro-js": "^1.2.1",
    "node-llama-cpp": "^3.0.0",
    "ws": "^8.20.0"
  },
  "optionalDependencies": {
    "naudiodon": "^2.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.9.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^4.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.57.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.0",
    "temp": "file:vendor/temp"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/clark970417-eng/VocaLume.git",
    "directory": "desktop-app"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "sharp": "0.35.5",
    "simple-git": "4.0.2",
    "@electron/asar": "4.3.1",
    "@electron/universal": "3.0.6",
    "filelist": "2.0.2",
    "minimatch": "11.0.4",
    "glob@>=9": "14.0.3",
    "temp": "$temp"
  }
}
