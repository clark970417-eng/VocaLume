{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/mobile/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/download/SHA256SUMS.txt",
      "destination": "https://github.com/clark970417-eng/VocaLume/releases/download/beta-v4.6.6/SHA256SUMS.txt",
      "permanent": false
    },
    {
      "source": "/download",
      "destination": "https://github.com/clark970417-eng/VocaLume/releases/tag/beta-v4.6.6",
      "permanent": false
    }
  ]
}
